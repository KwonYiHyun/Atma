@echo off
chcp 65001 > nul
setlocal

:: =================================================================
:: [설정 구역] 아래 두 경로만 수정하세요.
:: =================================================================

:: 1. 원본 폴더 (여기 있는 파일을 가져옵니다)
set "SOURCE_DIR=C:\git\Twinkle\Twinkle\ServerData\Android"

:: 2. 대상 폴더 (여기에 덮어씌웁니다)
set "DEST_DIR=C:\git\Empen\Empen\wwwroot\resource\android"

:: =================================================================
:: [실행 구역]
:: =================================================================

echo.
echo [복사 시작]
echo 원본: "%SOURCE_DIR%"
echo 대상: "%DEST_DIR%"
echo.

:: 안전장치: 원본이 없으면 중단
if not exist "%SOURCE_DIR%" (
    echo [ERROR] 원본 폴더가 없습니다! 경로를 확인하세요.
    pause
    exit /b
)

:: 안전장치: 대상 폴더가 없으면 생성
if not exist "%DEST_DIR%" (
    echo [INFO] 대상 폴더가 없어서 새로 만듭니다.
    mkdir "%DEST_DIR%"
)

:: -----------------------------------------------------------------
:: [Robocopy 명령어 설명]
:: /E  : 비어있는 하위 폴더까지 전부 포함해서 복사
:: /IS : (핵심) 파일이 이미 있고 내용이 같더라도 강제로 덮어쓰기 (Include Same)
:: /IT : (핵심) 파일 속성만 달라도 덮어쓰기 (Include Tweaked)
:: /XO : 이 옵션은 뺐습니다 (구버전 덮어쓰기 허용을 위해)
:: /R:1 /W:1 : 오류 시 1회 재시도, 1초 대기
:: -----------------------------------------------------------------

robocopy "%SOURCE_DIR%" "%DEST_DIR%" /E /IS /IT /R:1 /W:1

echo.
echo ---------------------------------------------------
echo 모든 작업이 완료되었습니다.
pause